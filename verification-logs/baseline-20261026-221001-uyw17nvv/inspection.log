wait_ready_file() {
    local marker=$1 pid=$2
    for ((n=0; n<stage_timeout*10; n++)); do
        kill -0 "$pid" 2>/dev/null || fail "Child $pid exited before readiness; inspect its log."
        [[ -e $marker ]] && return 0
