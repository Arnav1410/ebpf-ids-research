# Literal KEY=VALUE data, not a shell script. Never source this file.
# Copy to .env (gitignored); file values override builtins, CLI overrides file.
# Paths below are relative to the repository root, not this file's directory.
# Comments must occupy their own line. No interpolation or command substitution.

# Physical-lab discovery only; unset targets fail closed.
IDS_VM_NAME=
IDS_LIBVIRT_URI=qemu:///system
IDS_HOST_WIRED_IFACE=
IDS_GUEST_MANAGEMENT_IFACE=enp1s0
IDS_GUEST_MANAGEMENT_MAC=52:54:00:73:34:a0
IDS_GUEST_DEMO_IFACE=
IDS_GUEST_DEMO_MAC=
IDS_CLIENT_IPV4=
IDS_GUEST_DEMO_IPV4=
IDS_TCP_PORT=5001

# These service settings are applied by python -m test_env.serve.
# live remains the accepted PRIVATE namespace lab, not physical attachment.
IDS_DASHBOARD_PORT=8765
IDS_RUN_SECONDS=120
IDS_REPLAY_INTERVAL=0.5
IDS_LOADER=.output/test-env-stage-06/build/nn-loader
IDS_OBJECT=.output/test-env-stage-06/build/nn.bpf.o
IDS_BPFTOOL=.output/test-env-stage-01/deps/bpftool/bpftool
# Empty reader follows the effective loader's sibling nn-collect.
IDS_READER=
IDS_MODEL=src/mlp_params.bpf.h
# Set a genuine recorded sample for replay, or pass --sample.
IDS_SAMPLE=
# A NEW exclusive log directory; blank means supply --out on the command line.
IDS_OUT=
